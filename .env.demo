# Demonstração acadêmica (dados fictícios): `npm run docker:up`, ou
#   docker compose --env-file .env.demo up --build
# Aceita os segredos públicos padrão do docker-compose.yml, grava os dados de
# demonstração e mostra as contas de demonstração na tela de login.
# NÃO use em uma instalação de verdade (veja .env.example).
DEMO_MODE=true
